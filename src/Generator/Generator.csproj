    <Reference Include="Splat"><HintPath>../../lib/TEdit/Splat.dll</HintPath></Reference>
    <Reference Include="Splat.Logging"><HintPath>../../lib/TEdit/Splat.Logging.dll</HintPath></Reference>
  </ItemGroup>
</Project>
