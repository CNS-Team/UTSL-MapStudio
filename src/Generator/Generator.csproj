    <Reference Include="TEdit.Common"><HintPath>../../lib/TEdit/TEdit.Common.dll</HintPath></Reference>
    <Reference Include="ReactiveUI"><HintPath>../../lib/TEdit/ReactiveUI.dll</HintPath></Reference>
