    <Reference Include="System.Reactive"><HintPath>../../lib/TEdit/System.Reactive.dll</HintPath></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>../../lib/TEdit/Newtonsoft.Json.dll</HintPath></Reference>
    <Reference Include="ColorMinePortable"><HintPath>../../lib/TEdit/ColorMinePortable.dll</HintPath></Reference>
    <Reference Include="PropertyModels"><HintPath>../../lib/TEdit/PropertyModels.dll</HintPath></Reference>
    <Reference Include="ReactiveUI.Disposables"><HintPath>../../lib/TEdit/ReactiveUI.Disposables.dll</HintPath></Reference>
