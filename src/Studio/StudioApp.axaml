<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MapStudio.StudioApp" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#E6EDF8"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#8C9BB1"/></Style>
    <Style Selector="TextBlock.caption"><Setter Property="Foreground" Value="#96A4B9"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="13,8"/><Setter Property="Background" Value="#252C39"/><Setter Property="BorderBrush" Value="#333E50"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#74A2FF"/><Setter Property="Foreground" Value="#101724"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Button.traffic"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="MinHeight" Value="0"/><Setter Property="MinWidth" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="7"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#141A24"/><Setter Property="BorderBrush" Value="#333E50"/><Setter Property="MinHeight" Value="35"/></Style>
    <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#141A24"/><Setter Property="BorderBrush" Value="#333E50"/><Setter Property="MinHeight" Value="35"/><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
    <Style Selector="CheckBox"><Setter Property="MinHeight" Value="28"/><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="MenuItem"><Setter Property="Padding" Value="12,9"/></Style>
  </Application.Styles>
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#78A4FF</Color>
    <Color x:Key="SystemAccentColorDark1">#658FDA</Color>
    <Color x:Key="SystemAccentColorDark2">#527ABD</Color>
    <Color x:Key="SystemAccentColorDark3">#44679E</Color>
    <Color x:Key="SystemAccentColorLight1">#91B6FF</Color>
    <Color x:Key="SystemAccentColorLight2">#AAC7FF</Color>
    <Color x:Key="SystemAccentColorLight3">#C3D8FF</Color>
  </Application.Resources>
</Application>
